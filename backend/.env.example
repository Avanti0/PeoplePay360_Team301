# Option 1: use individual PG vars (matches database team's .env.example)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=peoplepay360

# Option 2: override with full URL if preferred
# DATABASE_URL=postgresql://postgres:password@localhost:5432/peoplepay360

SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com

# PDF output directory
PDF_DIR=/tmp/payslips
